<launch>
  <!-- BPS node in map_voxels mode: bridge-style voxel clouds replace the ray buffer. -->
  <node pkg="dynasense" type="dynasense_bps_node" name="map_voxel_bps" output="screen">
    <rosparam command="load" file="$(find dynasense)/config/bps.yaml"/>
    <param name="map_frame" value="odom"/>
    <param name="ground_z" value="0.0"/>
    <param name="ray_voxel_source" value="map_voxels"/>
    <param name="map_voxel_topic" value="/map_voxel_test/voxels"/>
    <param name="map_voxel_timeout" value="0.3"/>
    <param name="ray_buffer_capacity" value="3"/>
    <param name="state_topic" value="/map_voxel_test/state"/>
    <param name="marker_topic" value="/map_voxel_test/markers"/>
    <param name="reset_service" value="/map_voxel_test/reset"/>
    <param name="contact_topic_format" value="/map_voxel_test/contacts/{leg}/{body}"/>
    <rosparam param="contact_bodies">[thigh]</rosparam>
    <rosparam param="depth_cloud_topics">[/map_voxel_test/sensor_cloud]</rosparam>
    <param name="use_lidar" value="false"/>
    <param name="contact_rising_edge_only" value="false"/>
    <param name="contact_frame_debug_count" value="0"/>
  </node>
  <test test-name="map_voxels" pkg="dynasense" type="test_map_voxels.py" time-limit="60"/>
</launch>
