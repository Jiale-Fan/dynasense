<?xml version="1.0"?>
<!--
  Real robot: everything the ContactBPS controller needs besides the mapping,
  for a floor height already measured (normally started by
  scripts/start_bps_hardware.sh, which estimates floor_z from the feet first).

    floor_z_topic (latched)      the floor height, read by the wavemap bridge of
                                 launch/live_wavemap.launch (its z band) and by
                                 the clearance node
    dynasense_bps_node           config/bps.yaml + config/bps_live.yaml, map_frame
                                 = frame, ground_z = floor_z, ray voxels from the
                                 bridge (/dynasense/wavemap_voxels)
    dynasense_fk_ground_clearance  the 17 gravity rays of the policy observation as
                                 link heights above the flat floor, replacing the
                                 Gazebo plugin on /dynasense/ground_clearance

  Usage:
    rosrun dynasense start_bps_hardware.sh                    # estimates the floor, then this file
    roslaunch dynasense bps_hardware.launch floor_z:=-0.29    # with a known floor height
-->
<launch>
  <arg name="floor_z"/>                                          <!-- m in frame -->
  <arg name="frame"               default="odom"/>
  <arg name="floor_z_topic"       default="/dynasense/floor_z"/>
  <arg name="bps_config"          default="$(find dynasense)/config/bps.yaml"/>
  <arg name="bps_live_config"     default="$(find dynasense)/config/bps_live.yaml"/>
  <arg name="ground_clearance"    default="true"/>               <!-- false when another source publishes it -->
  <arg name="clearance_rate"      default="50.0"/>               <!-- Hz, the policy rate -->
  <arg name="clearance_max_range" default="2.0"/>                <!-- m, as the Gazebo plugin -->

  <node pkg="rostopic" type="rostopic" name="dynasense_floor_z" output="log"
        args="pub -l $(arg floor_z_topic) std_msgs/Float64 'data: $(arg floor_z)'"/>

  <node pkg="dynasense" type="dynasense_bps_node" name="dynasense_bps_node" output="screen">
    <rosparam command="load" file="$(arg bps_config)"/>
    <rosparam command="load" file="$(arg bps_live_config)"/>
    <param name="map_frame" type="str"    value="$(arg frame)"/>
    <param name="ground_z"  type="double" value="$(arg floor_z)"/>
  </node>

  <node pkg="dynasense" type="dynasense_fk_ground_clearance_node" name="dynasense_fk_ground_clearance"
        output="screen" if="$(arg ground_clearance)">
    <param name="floor_z"   type="double" value="$(arg floor_z)"/>
    <param name="frame"     type="str"    value="$(arg frame)"/>
    <param name="rate"      type="double" value="$(arg clearance_rate)"/>
    <param name="max_range" type="double" value="$(arg clearance_max_range)"/>
  </node>
</launch>
